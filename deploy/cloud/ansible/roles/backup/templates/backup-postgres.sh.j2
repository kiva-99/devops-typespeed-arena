#!/usr/bin/env bash

set -euo pipefail

DB_NAME="{{ backup_db_name }}"
DB_USER="{{ backup_db_user }}"
DB_HOST="{{ backup_db_host }}"
DB_PORT="{{ backup_db_port }}"
BACKUP_DIR="{{ backup_local_dir }}"
BUCKET="{{ backup_bucket_name }}"
APP_HEALTH_URL="{{ backup_app_health_url }}"
REQUIRE_APP_HEALTH="{{ backup_require_app_health }}"

TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_FILE="${BACKUP_DIR}/${DB_NAME}-${TIMESTAMP}.sql.gz"

mkdir -p "$BACKUP_DIR"

echo "[backup] Starting PostgreSQL backup at $(date -Is)"

echo "[backup] Checking PostgreSQL service..."
systemctl is-active --quiet postgresql@14-main

echo "[backup] Checking database connection..."
sudo -u postgres psql -d "$DB_NAME" -c "SELECT 1;" >/dev/null

if [ "$REQUIRE_APP_HEALTH" = "true" ]; then
  echo "[backup] Checking application health: $APP_HEALTH_URL"
  curl -fsS "$APP_HEALTH_URL" >/dev/null
else
  echo "[backup] Application health check is disabled for now"
fi

echo "[backup] Creating dump: $BACKUP_FILE"
sudo -u postgres pg_dump "$DB_NAME" | gzip > "$BACKUP_FILE"

echo "[backup] Uploading to Object Storage bucket: $BUCKET"
aws --endpoint-url=https://storage.yandexcloud.net s3 cp "$BACKUP_FILE" "s3://${BUCKET}/postgres/$(basename "$BACKUP_FILE")"

echo "[backup] Removing local backups older than {{ backup_retention_days }} days"
find "$BACKUP_DIR" -type f -name "*.sql.gz" -mtime +{{ backup_retention_days }} -delete

echo "[backup] Done: $(basename "$BACKUP_FILE")"

