services:
  backend:
    image: "${BACKEND_IMAGE}"
    container_name: typespeed-backend
    env_file:
      - backend-image.env
    environment:
      DATABASE_URL: "{{ app_database_url }}"
      PORT: "5000"
      DEBUG: "false"
      LOG_DIR: "/app/logs"
      LOG_FILE: "/app/logs/typespeed-backend.log"
      LOG_LEVEL: "INFO"
    volumes:
      - ./logs:/app/logs
    ports:
      - "5001:5000"
    restart: unless-stopped

  frontend:
    image: nginx:alpine
    container_name: typespeed-frontend
    volumes:
      - ./frontend:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "80:80"
    depends_on:
      - backend
    restart: unless-stopped
