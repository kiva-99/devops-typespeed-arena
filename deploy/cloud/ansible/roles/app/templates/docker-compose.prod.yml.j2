services:
  backend:
    image: "${BACKEND_IMAGE}"
    container_name: typespeed-backend
    env_file:
      - backend-image.env
    environment:
      DATABASE_URL: "{{ app_database_url }}"
      PORT: "5000"
      DEBUG: "false"
      LOG_DIR: "/app/logs"
      LOG_FILE: "/app/logs/typespeed-backend.log"
      LOG_LEVEL: "INFO"
    volumes:
      - ./logs:/app/logs
    ports:
      - "5001:5000"
    restart: unless-stopped

  frontend:
    image: nginx:alpine
    container_name: typespeed-frontend
    volumes:
      - ./frontend:/usr/share/nginx/html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "80:80"
    depends_on:
      - backend
    restart: unless-stopped

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: typespeed-cadvisor
    privileged: true
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    restart: unless-stopped

  promtail:
    image: grafana/promtail:latest
    container_name: typespeed-promtail
    command:
      - "-config.file=/etc/promtail/config.yml"
    volumes:
      - ./promtail-config.yml:/etc/promtail/config.yml:ro
      - ./logs:/var/log/typespeed:ro
    depends_on:
      - backend
    restart: unless-stopped
