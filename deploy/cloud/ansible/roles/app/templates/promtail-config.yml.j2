server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://10.10.10.36:3100/loki/api/v1/push

scrape_configs:
  - job_name: typespeed-backend
    static_configs:
      - targets:
          - localhost
        labels:
          job: typespeed-backend
          service: typespeed-backend
          host: typespeed-app-node
          __path__: /var/log/typespeed/typespeed-backend.log
