global:
  resolve_timeout: 5m
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "{{ alert_email_from }}"
  smtp_auth_username: "{{ alert_email_from }}"
  smtp_auth_password: "{{ alert_email_password }}"
  smtp_require_tls: true

route:
  receiver: "gmail"
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h

receivers:
  - name: "gmail"
    email_configs:
      - to: "{{ alert_email_to }}"
        send_resolved: true
